# Spielplan configuration — spec v2.1 §2.
# Copy to .env and fill in. Back this file up ALONGSIDE the pg_dumps: dumps contain
# ciphertext only, and a restored dump cannot decrypt connector config without SECRETS_KEY.
# The worker writes one dump a night to ./data/backups, at 06:00 household time, and keeps the
# newest 14 (§2) — fourteen nights, not fourteen files: a restart no longer spends a slot and a
# second dump on the same date is refused. A copy of those without a copy of this file restores
# an install whose connectors cannot be re-enabled. README's Recovery section is the procedure —
# and a dump restores only into the image that wrote it, because pg_restore --clean drops what the
# archive holds and a table a later release added is not in it. An older dump needs a database with
# nothing newer in it; README says how.

# The origin the app is reached on, via Traefik/Cloudflare AND via Tailscale.
# WebAuthn binds passkeys to this origin — changing it invalidates every registered credential.
PUBLIC_URL=https://spielplan.example.tld

# Signs session cookies. Rotating this invalidates sessions only; stored secrets are untouched.
# At least 32 characters, or the app refuses to start and says which value is short: nothing
# falls back to a constant any more, and a cookie signed with a guessable key is anybody's
# session.
# generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Wraps the data-encryption key that AEAD-encrypts connector secrets.
# The app REFUSES to start secret-dependent connectors without it, and refuses to start at all if
# it is set to something under 32 characters — any shorter value was typed by hand, and it guards
# a Jellyfin key §14.3 calls admin-equivalent.
#
# Rotating it is an explicit admin action that re-wraps the one DEK row. It loses nothing: the
# data-encryption key itself does not change, so every ciphertext and every key_id stays as it is
# and only the wrapping moves. Both values are arguments because no running process holds the one
# being replaced — so run it while you have both, then put the new value here and restart:
#
#   docker compose exec backend spielplan-secrets \
#       rewrap --old-key <the value here now> --new-key <the value going here>
#   # then set SECRETS_KEY below to the new value
#   docker compose up -d
#
# If the value here now is SHORTER than 32 characters, that order is impossible and the reverse is
# the way out. Nothing before M4.7 checked the length, so such an install exists; on upgrade it
# stops booting, and so does the command above — `spielplan-secrets` builds the same Settings the
# app does before it opens a connection, so it dies on the value sitting in this file rather than
# on either argument it was given. That is why --old-key alone is exempt from the floor: this
# install is the one the floor strands, and rewrapping away from a short key is its only door out.
# So the new value goes in FIRST, and the command follows it:
#
#   # set SECRETS_KEY below to the new value
#   docker compose up -d
#   docker compose exec backend spielplan-secrets \
#       rewrap --old-key <the short value> --new-key <the value now below>
#
# The app boots in between with custody reported unreadable, which is a legal state (§3.1) and not
# a loss — every ciphertext is still there, wrapped under the short key the rewrap is about to
# replace. Nothing further is needed afterwards either: the DEK is read per request rather than
# held from boot, so the next look at Admin > System is already the repaired one. One thing not to
# do in that window: Save on Admin > Connectors retires the unreadable row and mints a fresh one.
# That is the right repair for a key that is GONE, and here it throws away the row the rewrap was
# about to rescue.
#
# If the old key is already gone — a dump restored without its .env — rotation has nothing to
# re-wrap. `spielplan-secrets reset` is the lossy way back: it retires what it cannot open, clears
# the ciphertexts that named it and prints them, and the Admin > Connectors card is then filled in
# by hand. README's Recovery section walks it.
# generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRETS_KEY=

TZ=Europe/Berlin

# Postgres. The password is stated once, here: docker-compose.yml builds the app containers'
# DATABASE_URL out of these three, so there is no second place for it to drift from. It used to
# be declared twice, and an operator who set a real password and left the URL as copied got a
# backend that could not authenticate, on first boot, with nothing but a traceback to say so.
POSTGRES_USER=spielplan
# Keep this URL-safe: letters, digits, `-` and `_`. The `db` service receives it verbatim, so
# Postgres accepts anything — but docker-compose.yml also interpolates it into DATABASE_URL, and
# that half is parsed as a URL, so a character with a meaning there produces a server that holds
# the password and a backend that cannot send it. Measured against asyncpg's own DSN parser:
# `p@ss` splits at the FIRST @, giving password `p` and host `ss@db`; `/`, `#` and `?` end the
# netloc, and the boot dies in urllib with `invalid literal for int()` rather than anything naming
# this file; `%20` is percent-DEcoded, so what reaches Postgres is not what is typed here.
# generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me
POSTGRES_DB=spielplan

# Only for §2's other supported install: a Postgres outside this compose file. Setting it
# overrides the URL compose builds, and it is then the one place the password lives — so a
# password containing @ or / (or anything else a URL gives meaning to) must be percent-encoded,
# because the whole value is parsed as a URL. The nightly dump decodes it back out before handing
# it to pg_dump via PGPASSWORD, never on the command line.
# DATABASE_URL=postgresql://spielplan:change-me@db:5432/spielplan

# Where the backend listens on the host (Traefik proxies to this).
BIND_ADDR=127.0.0.1
PORT=8080

# --- optional: seed connector config on first boot only (automated installs) ---
# Everything connector-related is configured in the Admin UI and stored in `connector_config`.
# These env vars only SEED that table on first boot; afterwards the DB is authoritative and
# these are ignored — an edit made in the Admin UI is never reverted by a restart.
#
# Seeding a secret requires SECRETS_KEY. Without it the app refuses to start rather than
# storing the key in the clear (§2).
#
# JELLYFIN_URL=http://jellyfin.local:8096
# JELLYFIN_API_KEY=
#
# The rest are configured in the Admin UI at M5 and can be seeded the same way.
# TMDB_API_KEY=
# OMDB_API_KEY=
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=
